  // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [selectedSource]);

  // 鈹€鈹€ 绔嬪嵆鍚屾锛坈heckpoint 椹卞姩锛屾湁璁板綍鈫掑閲忥紝鏃犺褰曗啋鍏ㄩ噺锛夆攢鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
  async function triggerSync(source: string = selectedSource) {
    setSyncing('sync');
    setTriggerMsg(null);
    try {
      const res = await fetch(`${CRAWLER_API}/schedule/trigger`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mode: 'incremental', source }),
      });
      const data = await res.json();
      setTriggerMsg(data.message || data.status);
      setTimeout(() => { fetchSchedule(); fetchSourceStatus(source); }, 2000);
    } catch (e) {
      setTriggerMsg(`瑙﹀彂澶辫触: ${e}`);
    } finally {
      setSyncing(null);
    }
  }

  // 鈹€鈹€ 娓呯┖ checkpoint 骞堕噸鏂板叏閲忕埇鍙?鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
  async function resetCheckpointAndSync(source: string = selectedSource) {
    const label = SOURCE_META[source]?.label ?? source;
    if (!confirm(`纭畾娓呯┖ ${label} 鐨勫叏閮?checkpoint 骞堕噸鏂板叏閲忕埇鍙栵紵\n\n宸插叆搴撴暟鎹笉浼氬垹闄わ紝浣嗙埇铏皢閲嶆柊鐖彇鎵€鏈夊巻鍙查〉闈紙鑰楁椂杈冮暱锛夈€俙)) return;
    setSyncing('reset-sync');
    setTriggerMsg(null);
    try {
      // Step 1: 娓呯┖ checkpoint
      const resetRes = await fetch(
        `${CRAWLER_API}/schedule/reset-checkpoint?source=${encodeURIComponent(source)}`,
        { method: 'POST' },
      );
      if (!resetRes.ok) throw new Error(`娓呯┖ checkpoint 澶辫触 HTTP ${resetRes.status}`);
      const resetData = await resetRes.json();
      // Step 2: 瑙﹀彂鍏ㄩ噺鐖彇
      const trigRes = await fetch(`${CRAWLER_API}/schedule/trigger`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mode: 'full', source }),
      });
      const trigData = await trigRes.json();
      setTriggerMsg(`宸叉竻绌?${resetData.cleared} 涓?checkpoint 骞惰Е鍙戝叏閲忕埇鍙?路 ${trigData.message ?? ''}`);
      setTimeout(() => { fetchSchedule(); fetchSourceStatus(source); }, 2000);
    } catch (e) {
      setTriggerMsg(`鎿嶄綔澶辫触: ${e}`);
    } finally {
      setSyncing(null);
    }
  }

  // 鈹€鈹€ APScheduler 浠诲姟鎺у埗 鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€鈹€
