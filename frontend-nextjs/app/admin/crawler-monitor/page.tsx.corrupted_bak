                          onClick={() => saveJobCron(job.id)}
                          disabled={!!jobAction}
                          className="flex items-center gap-1 px-4 py-2 bg-purple-600 text-white rounded-lg text-xs font-medium hover:bg-purple-700 disabled:opacity-50"
                        >
                          {jobAction === `cron:${job.id}` ? '淇濆瓨涓?..' : '淇濆瓨'}
                        </button>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      )}

      {/* 鈺愨晲 瀹炴椂鐩戞帶 Tab 鈺愨晲 */}
      {activeTab === 'monitor' && (
        <div className="space-y-5">
          {/* Stats */}
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <StatCard label="娲昏穬浠诲姟" value={activeTasks} unit="涓繍琛屼腑" />
            <StatCard label="绱鐖彇" value={totalCompleted} unit="涓」鐩? />
            <StatCard label="鎴愬姛鐜? value={successRate.toFixed(1)} unit="%" />
            <StatCard label="骞冲潎鑰楁椂" value={avgTime.toFixed(2)} unit="绉?椤? />
          </div>

          {/* Controls */}
          <div className="flex flex-wrap gap-3">
            <button onClick={() => startCrawl('gooood')} className="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 text-sm font-medium">鍚姩 Gooood</button>
            <button onClick={() => startCrawl('archdaily')} className="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 text-sm font-medium">鍚姩 Archdaily</button>
            <button onClick={() => startCrawl('dezeen')} className="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 text-sm font-medium">鍚姩 Dezeen</button>
            <div className="flex-1" />
            <button onClick={() => controlAll('pause')} className="px-4 py-2 bg-yellow-500 text-white rounded-lg hover:bg-yellow-600 text-sm font-medium">鏆傚仠鍏ㄩ儴</button>
            <button onClick={() => controlAll('resume')} className="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 text-sm font-medium">鎭㈠鍏ㄩ儴</button>
            <button onClick={() => controlAll('stop')} className="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 text-sm font-medium">鍋滄鍏ㄩ儴</button>
          </div>

          {/* Active Tasks */}
          <div className="bg-white rounded-xl shadow-sm border p-6">
            <h2 className="text-lg font-semibold text-gray-900 mb-4">娲昏穬浠诲姟</h2>
            {taskList.length === 0 ? (
              <p className="text-center text-gray-400 py-8">鏆傛棤娲昏穬浠诲姟</p>
            ) : (
              <div className="space-y-4">
                {taskList.map(task => (
                  <div key={task.task_id} className="border rounded-lg p-4">
                    <div className="flex items-center justify-between mb-3">
                      <span className="font-medium text-gray-900">{task.task_id}</span>
                      <span className={`px-2.5 py-0.5 rounded-full text-xs font-medium ${statusColor[task.status] || 'bg-gray-100 text-gray-800'}`}>{task.status}</span>
                    </div>
                    <div className="w-full bg-gray-200 rounded-full h-2 mb-3">
                      <div className="bg-blue-600 h-2 rounded-full transition-all duration-300" style={{ width: `${task.progress_percent}%` }} />
                    </div>
                    <div className="grid grid-cols-3 sm:grid-cols-6 gap-2 text-sm text-gray-600">
                      <div>杩涘害: <span className="font-medium text-gray-900">{task.completed}/{task.total}</span></div>
                      <div>鎴愬姛鐜? <span className="font-medium text-gray-900">{(task.success_rate * 100).toFixed(1)}%</span></div>
                      <div>澶辫触: <span className="font-medium text-gray-900">{task.failed}</span></div>
                      <div>璇锋眰鏁? <span className="font-medium text-gray-900">{task.requests_count}</span></div>
                      <div>鎵规: <span className="font-medium text-gray-900">{task.current_batch}/{task.total_batches}</span></div>
                      <div>鑰楁椂: <span className="font-medium text-gray-900">{task.avg_response_time.toFixed(2)}s</span></div>
                    </div>
                    {task.last_error && <p className="mt-2 text-xs text-red-600">閿欒: {task.last_error}</p>}
                    {task.current_url && <p className="mt-2 text-xs text-gray-400 break-all">褰撳墠: {task.current_url}</p>}
                  </div>
                ))}
              </div>
            )}
          </div>

          {/* Logs */}
          <div className="bg-white rounded-xl shadow-sm border p-6">
            <div className="flex items-center justify-between mb-4">
              <h2 className="text-lg font-semibold text-gray-900">瀹炴椂鏃ュ織</h2>
              <button onClick={() => setLogs([])} className="px-3 py-1 text-sm bg-gray-100 text-gray-600 rounded-lg hover:bg-gray-200">娓呯┖</button>
            </div>
            <div className="bg-gray-900 rounded-lg p-4 max-h-80 overflow-y-auto font-mono text-xs leading-relaxed">
              {logs.map(log => (
                <div key={log.id} className="flex gap-3 mb-1">
                  <span className="text-gray-500 whitespace-nowrap">[{log.timestamp}]</span>
                  <span className={`w-12 font-semibold ${logColor[log.level] || 'text-gray-400'}`}>{log.level.toUpperCase()}</span>
                  <span className="text-gray-300">{log.message}</span>
                </div>
              ))}
              <div ref={logsEndRef} />
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

function FullCrawlBadge({ status }: { status: string }) {
  const map: Record<string, { cls: string; label: string }> = {
    pending:   { cls: 'bg-gray-100 text-gray-600',    label: '寰呮墽琛? },
    running:   { cls: 'bg-blue-100 text-blue-700',    label: '杩涜涓? },
    completed: { cls: 'bg-green-100 text-green-700',  label: '宸插畬鎴? },
    failed:    { cls: 'bg-red-100 text-red-700',      label: '澶辫触' },
  };
  const { cls, label } = map[status] || map.pending;
  return <span className={`px-2.5 py-0.5 rounded-full text-xs font-medium ${cls}`}>{label}</span>;
}

function StatCard({ label, value, unit }: { label: string; value: string | number; unit: string }) {
  return (
    <div className="bg-white rounded-xl shadow-sm border p-5">
      <p className="text-sm text-gray-500 mb-1">{label}</p>
      <p className="text-3xl font-bold text-gray-900">{value}</p>
      <p className="text-sm text-gray-400">{unit}</p>
    </div>
  );
}

