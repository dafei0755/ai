        setSyncHistory((await histRes.value.json()).history || []);
      if (statsRes.status === 'fulfilled' && statsRes.value.ok)
        setSourceStats((await statsRes.value.json()).stats || []);
      if (issuesRes.status === 'fulfilled' && issuesRes.value.ok)
