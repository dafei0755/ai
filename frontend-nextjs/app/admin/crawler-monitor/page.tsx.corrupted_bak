    if (action === 'stop' && !confirm('纭畾瑕佸仠姝㈡墍鏈変换鍔″悧锛?)) return;
    const labels: Record<string, string> = { pause: '鏆傚仠', resume: '鎭㈠', stop: '鍋滄' };
    for (const taskId of Object.keys(tasks)) {
      try { await apiCall(`/${action}/${taskId}`, 'POST'); addLog('info', `浠诲姟宸?{labels[action]}: ${taskId}`); }
