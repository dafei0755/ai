  const avgTime = totalRequests > 0 ? taskList.reduce((s, t) => s + t.avg_response_time * t.requests_count, 0) / totalRequests : 0;
  const successRate = (totalCompleted + totalFailed) > 0 ? (totalCompleted / (totalCompleted + totalFailed) * 100) : 0;

