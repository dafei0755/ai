				return;
			}

			if (event.key === 'ArrowLeft') {
				event.preventDefault();
				showPrevDetailImage();
				return;
			}

			if (event.key === 'ArrowRight') {
				event.preventDefault();
				showNextDetailImage();
			}
		};

		window.addEventListener('keydown', handleKeyDown);
		return () => window.removeEventListener('keydown', handleKeyDown);
