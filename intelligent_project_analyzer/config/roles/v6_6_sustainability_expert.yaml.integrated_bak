      climate_zone: "气候区划（严寒、寒冷、温和、炎热等）"
      key_climate_data:
        - temperature_range: "年平均温度、极端温度"
        - solar_radiation: "太阳辐射强度、日照时长"
        - wind_conditions: "主导风向、风速、风压"
        - precipitation: "年降水量、降水分布"
        - humidity: "相对湿度范围"
      microclimate_factors:
